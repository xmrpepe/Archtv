# ArchDock picom base config. archdock-compositor prepends backend/shadow/blur
# (toggled from the Android app) and appends the theme's colors.conf.
vsync = true;
use-damage = true;
unredir-if-possible = true;          # full-screen games/video bypass the compositor
glx-no-stencil = true;

# Rounded corners
corner-radius = 10;
rounded-corners-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'",
  "window_type = 'tooltip'",
  "class_g = 'Mate-panel'",
  "class_g = 'Rofi'",
  "class_g = 'Dunst'"
];

# Soft shadows
shadow-radius = 18;
shadow-opacity = 0.45;
shadow-offset-x = -14;
shadow-offset-y = -10;
shadow-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'",
  "window_type = 'menu'",
  "window_type = 'dropdown_menu'",
  "window_type = 'popup_menu'",
  "window_type = 'tooltip'",
  "class_g = 'Mate-panel'",
  "_GTK_FRAME_EXTENTS@"
];

# Blur behind translucent windows (terminal, launcher, notifications)
blur-background-exclude = [
  "window_type = 'desktop'",
  "window_type = 'dock'",
  "class_g = 'firefox' && argb",
  "_GTK_FRAME_EXTENTS@"
];
opacity-rule = [
  "94:class_g = 'Alacritty' && focused",
  "88:class_g = 'Alacritty' && !focused",
  "96:class_g = 'Rofi'"
];

# Subtle fades
fading = true;
fade-in-step = 0.08;
fade-out-step = 0.08;
fade-delta = 6;
no-fading-openclose = false;

detect-rounded-corners = true;
detect-client-opacity = true;
detect-transient = true;
mark-wmwin-focused = true;
mark-ovredir-focused = true;
