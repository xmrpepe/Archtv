# ArchDock first-login defaults for MATE (loaded with `dconf load /`).
# Omarchy-style keys, fonts and the slim top panel. Edit freely; it is only
# applied once per user (delete ~/.config/archdock/dconf-loaded to reapply).

[org/mate/marco/general]
num-workspaces=9
titlebar-font='Inter Bold 10'
button-layout=':minimize,maximize,close'
compositing-manager=false
focus-new-windows='strict'
center-new-windows=true
allow-tiling=true
show-tab-border=false

[org/mate/marco/global-keybindings]
run-command-terminal='disabled'
panel-run-dialog='<Alt>F2'
cycle-windows='<Alt>Tab'
switch-to-workspace-1='<Mod4>1'
switch-to-workspace-2='<Mod4>2'
switch-to-workspace-3='<Mod4>3'
switch-to-workspace-4='<Mod4>4'
switch-to-workspace-5='<Mod4>5'
switch-to-workspace-6='<Mod4>6'
switch-to-workspace-7='<Mod4>7'
switch-to-workspace-8='<Mod4>8'
switch-to-workspace-9='<Mod4>9'

[org/mate/marco/window-keybindings]
close='<Mod4>w'
toggle-maximized='<Mod4>f'
toggle-fullscreen='<Mod4><Shift>f'
minimize='<Mod4>h'
tile-to-side-w='<Mod4>Left'
tile-to-side-e='<Mod4>Right'
begin-move='<Mod4>F7'
move-to-workspace-1='<Mod4><Shift>1'
move-to-workspace-2='<Mod4><Shift>2'
move-to-workspace-3='<Mod4><Shift>3'
move-to-workspace-4='<Mod4><Shift>4'
move-to-workspace-5='<Mod4><Shift>5'
move-to-workspace-6='<Mod4><Shift>6'
move-to-workspace-7='<Mod4><Shift>7'
move-to-workspace-8='<Mod4><Shift>8'
move-to-workspace-9='<Mod4><Shift>9'

[org/mate/marco/workspace-names]
name-1='1'
name-2='2'
name-3='3'
name-4='4'
name-5='5'
name-6='6'
name-7='7'
name-8='8'
name-9='9'

[org/mate/panel/general]
default-layout='archdock'

[org/mate/panel/objects/workspaces/prefs]
display-workspace-names=true
num-rows=1
display-all-workspaces=true

[org/mate/panel/objects/clock/prefs]
format='custom'
custom-format='<b>%A %H:%M</b>'
show-date=false
show-weather=false
show-temperature=false

[org/mate/panel/objects/cpu/prefs]
view-cpuload=true
view-memload=false
view-netload=false
view-swapload=false
view-loadavg=false
view-diskload=false
size=36
speed=1000

[org/mate/desktop/interface]
font-name='Inter 10'
document-font-name='Inter 10'
monospace-font-name='JetBrainsMono Nerd Font 10'
icon-theme='Papirus-Dark'
gtk-theme='ArchDock-tokyo-night'
enable-animations=true
toolbar-style='icons'

[org/mate/desktop/font-rendering]
antialiasing='rgba'
hinting='slight'
rgba-order='rgb'

[org/mate/desktop/peripherals/mouse]
cursor-theme='Adwaita'
cursor-size=24

[org/mate/desktop/applications/terminal]
exec='alacritty'
exec-arg='-e'

[org/mate/desktop/applications/browser]
exec='firefox'

[org/mate/desktop/session]
idle-delay=0

[org/mate/screensaver]
idle-activation-enabled=false
lock-enabled=false

[org/mate/power-manager]
sleep-display-ac=0
sleep-computer-ac=0

[org/mate/settings-daemon/plugins/media-keys]
screenshot=''
window-screenshot=''
area-screenshot=''
terminal=''

[org/mate/caja/desktop]
home-icon-visible=false
computer-icon-visible=false
trash-icon-visible=false
volumes-visible=false
network-icon-visible=false

[org/mate/caja/preferences]
default-folder-viewer='list-view'
show-hidden-files=false

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
