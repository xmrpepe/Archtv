# ArchDock zsh – Omarchy-style shell: starship, zoxide, fzf, eza, bat.
HISTFILE=~/.zsh_history HISTSIZE=50000 SAVEHIST=50000
setopt share_history hist_ignore_dups hist_ignore_space autocd interactive_comments
bindkey -e
autoload -Uz compinit && compinit -d ~/.cache/zcompdump
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

export PATH="$HOME/.local/bin:/opt/archdock/bin:$PATH"
export EDITOR=nvim VISUAL=nvim PAGER=less MANPAGER="sh -c 'col -bx | bat -l man -p'"

[ -f ~/.config/zsh/theme.zsh ] && source ~/.config/zsh/theme.zsh
source ~/.config/zsh/aliases.zsh

command -v starship >/dev/null && eval "$(starship init zsh)"
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
[ -f /usr/share/fzf/key-bindings.zsh ] && source /usr/share/fzf/key-bindings.zsh
[ -f /usr/share/fzf/completion.zsh ] && source /usr/share/fzf/completion.zsh
