[Desktop Entry]
Type=X-GNOME-Metatheme
Name=ArchDock {{ theme_name }}
Comment=Omarchy {{ theme_name }} palette for MATE (generated by ArchDock)
Encoding=UTF-8

[X-GNOME-Metatheme]
GtkTheme=ArchDock-{{ theme_id }}
MetacityTheme=ArchDock-{{ theme_id }}
IconTheme={{ icon_theme }}
CursorTheme=Adwaita
ButtonLayout=:minimize,maximize,close
