#!/bin/bash
# archdock-compositor start|stop|restart [--enabled=0|1] [--blur=0|1] [--shadows=0|1]
# Generates ~/.config/picom/picom.conf from the base config and the toggles
# set in the Android app, then (re)starts picom. Uses the GLX backend on a GPU
# renderer and xrender (no blur) on llvmpipe, where GLX would cost CPU.
RT=/tmp/archdock
[ -f "$RT/session.env" ] && . "$RT/session.env"
[ -f "$RT/compositor.env" ] && . "$RT/compositor.env"
cmd=${1:-restart}; shift || true
for a in "$@"; do
  case $a in
    --enabled=*) ARCHDOCK_COMPOSITOR=${a#*=} ;;
    --blur=*) ARCHDOCK_BLUR=${a#*=} ;;
    --shadows=*) ARCHDOCK_SHADOWS=${a#*=} ;;
  esac
done
if [ $# -gt 0 ]; then
  printf 'ARCHDOCK_COMPOSITOR=%s\nARCHDOCK_BLUR=%s\nARCHDOCK_SHADOWS=%s\n' \
    "${ARCHDOCK_COMPOSITOR:-1}" "${ARCHDOCK_BLUR:-1}" "${ARCHDOCK_SHADOWS:-1}" >"$RT/compositor.env"
fi

conf=$HOME/.config/picom/picom.conf
mkdir -p "$(dirname "$conf")"
[ -f "$HOME/.config/picom/colors.conf" ] || echo 'shadow-color = "#000000";' >"$HOME/.config/picom/colors.conf"
backend=glx; blur=${ARCHDOCK_BLUR:-1}
if [ "${ARCHDOCK_RENDERER:-llvmpipe}" = llvmpipe ]; then backend=xrender; blur=0; fi
{
  echo "# Generated by archdock-compositor – edit /opt/archdock/config/picom/picom.conf.base"
  echo "backend = \"$backend\";"
  echo "shadow = $([ "${ARCHDOCK_SHADOWS:-1}" = 1 ] && echo true || echo false);"
  if [ "$blur" = 1 ]; then echo 'blur: { method = "dual_kawase"; strength = 4; };'
  else echo 'blur: { method = "none"; };'; fi
  cat /opt/archdock/config/picom/picom.conf.base
  echo "@include \"$HOME/.config/picom/colors.conf\""
} >"$conf"

stop() { pkill -u "$USER" -x picom 2>/dev/null; for _ in 1 2 3 4 5; do pgrep -u "$USER" -x picom >/dev/null || break; sleep 0.2; done; }
case $cmd in
  stop) stop ;;
  start|restart)
    stop
    if [ "${ARCHDOCK_COMPOSITOR:-1}" = 1 ]; then
      picom --config "$conf" >"$RT/logs/picom.log" 2>&1 &
      disown
    fi ;;
  reload) pkill -USR1 -u "$USER" -x picom ;;
esac
